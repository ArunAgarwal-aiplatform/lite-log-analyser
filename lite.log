#!/bin/bash

mkdir -p report
cp access.log auth.log report/
chmod 644 report/*.log

echo "Top IPs:" > report/top_ips.txt
awk '{print $1}' report/access.log | sort | uniq -c | sort -nr | head -n 5 >> report/top_ips.txt

echo "Top Paths:" > report/top_paths.txt
awk -F'"' '{print $2}' report/access.log | awk '{print $2}' | sort | uniq -c | sort -nr | head -n 5 >> report/top_paths.txt

echo "Status Codes:" > report/status_codes.txt
awk -F'"' '{print $3}' report/access.log | awk '{print $1}' | sort | uniq -c | sort -nr > report/status_codes.txt

echo "Failed SSH IPs:" > report/failed_ips.txt
grep 'Failed password' report/auth.log | awk '{print $(NF-3)}' | sort | uniq -c | sort -nr > report/failed_ips.txt

grep -E 'curl|Nmap' report/access.log > report/suspicious_agents.txt
ps aux | head -n 5 > report/processes.txt
ss -tuln > report/ports.txt
find report -type f > report/files.txt
(dpkg -l 2>/dev/null || rpm -qa 2>/dev/null) | head -n 10 > report/packages.txt

echo "Done. Check report/"